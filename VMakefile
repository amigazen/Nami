#
# VMakefile — vbcc AmigaOS3 NetSurf / Nami / Tsunami
#
# Targets:
#   make -f VMakefile          -> NetSurf (static hubbub.lib + dom.lib)
#   make -f VMakefile Nami     -> Nami (hubbub.library + dom.library via PROGDIR:libs/)
#   make -f VMakefile Tsunami  -> Tsunami MUI frontend (static hubbub.lib + dom.lib, like NetSurf)
#   make -f VMakefile clean
#
# Nami runtime layout (beside the binary):
#   Nami
#   libs/hubbub.library
#   libs/dom.library
#

all: NetSurf

LIBDIR = build/vbcc-os3/lib
NAMILIBDIR = libs

NETSURF_QUICKJS_AMIGA_ROOT = /nea-quickjs
QJSROOT = $(NETSURF_QUICKJS_AMIGA_ROOT)
QJSVBCC = $(QJSROOT)/library/vbcc
VASM = vasmm68k_mot

VCFLAGS = +aos68k_posix -c99 -Dnsamiga -D__AMIGA__ -D_AMIGA -DPATH_MAX=1024 -cpu=68020 -DNDEBUG \
	-DWITH_HUBBUB -DWITH_AMIGA_ICON -DWITH_AMIGA_DATATYPES -DWITH_AMIHTTP \
	-DNETSURF_LOG_LEVEL=INFO \
	-Ifrontends/amiga/include \
	-Ifrontends/amiga/regex \
	-I. -Iinclude -Ifrontends -Ifrontends/amiga -Ifrontends/amiga/iconv \
	-Icontent/handlers \
	-Ivbcc-include \
	-I../libnsutils/include \
	-I../libwapcaplet/include \
	-I../libparserutils/include \
	-I../libhubbub/include \
	-I../libdom/include \
	-I../libdom/bindings \
	-I../libcss/include \
	-I../z.library/Source/lib_source/zlib \
	-I../z.library/SDK/Include_H \
	-I../libcodesets/developer/include \
	-I../AmiHTTP/SDK/Include_H \
	-I../ttengine.library/SDK/Include_H \
	-I../gtdrag.library/SDK/Include_h \
	-I../guigfxlib/include \
	-I../renderlib/include \
	-I../libopenurl/developer/C/include \
	-I../CGraphX/C/Include \
	-ISDK:Include_h \
	-Ivbcc:ns-vbcc/include \
	-INDK:Include/include_h

# Tsunami MUI frontend flags (DnsTsunami + MUI includes; still AmigaOS3)
VCFLAGS_TSUNAMI = +aos68k_posix -c99 -Dnsamiga -DnsTsunami -D__AMIGA__ -D_AMIGA -DPATH_MAX=1024 -cpu=68020 -DNDEBUG \
	-DWITH_HUBBUB -DWITH_AMIGA_ICON -DWITH_AMIGA_DATATYPES -DWITH_AMIHTTP \
	-DNETSURF_LOG_LEVEL=INFO \
	-Ifrontends/mui \
	-Ifrontends/amiga/include \
	-Ifrontends/amiga/regex \
	-I. -Iinclude -Ifrontends -Ifrontends/amiga -Ifrontends/amiga/iconv \
	-Icontent/handlers \
	-Ivbcc-include \
	-I../libnsutils/include \
	-I../libwapcaplet/include \
	-I../libparserutils/include \
	-I../libhubbub/include \
	-I../libdom/include \
	-I../libdom/bindings \
	-I../libcss/include \
	-I../z.library/Source/lib_source/zlib \
	-I../z.library/SDK/Include_H \
	-I../libcodesets/developer/include \
	-I../AmiHTTP/SDK/Include_H \
	-I../ttengine.library/SDK/Include_H \
	-I../gtdrag.library/SDK/Include_h \
	-I../guigfxlib/include \
	-I../renderlib/include \
	-I../libopenurl/developer/C/include \
	-I../CGraphX/C/Include \
	-I../../mui38dev/MUI/Developer/C/Include \
	-I../iconv.library/SDK/Include_h \
	-ISDK:Include_h \
	-Ivbcc:ns-vbcc/include \
	-INDK:Include/include_h

QJSCFLAGS = -DQJS_USE_LIBRARY -DJS_NAN_BOXING=0 \
	-I$(QJSROOT)/quickjs-master \
	-I$(QJSROOT)/include \
	-I$(QJSVBCC)

VLDFLAGS = -L$(LIBDIR) \
	-lcss -ldom -lhubbub -lparserutils -lwapcaplet -lnsutils

# Nami: LVO stubs for hubbub + dom (no -lhubbub / -ldom).
NAMI_LDFLAGS = -L$(LIBDIR) \
	-lcss -lparserutils -lwapcaplet -lnsutils

include frontends/amiga/vobjects.mak
include frontends/mui/vobjects.mak

# Core + MUI frontend (drop Reaction amiga frontend objects from OBJS).
# Also drop Amiga's iconv.o — Tsunami uses mui/iconv.c (iconv.library or
# renamed built-in fallback) so Amiga FE sources stay untouched.
TSUNAMI_OBJS = $(filter-out $(AMIGA_FE_OBJS) build/vbcc-os3/frontends_amiga_iconv_iconv.o,$(OBJS)) $(TSUNAMI_FE_OBJS)

ZOBJS = \
	build/vbcc-os3/frontends_amiga_z_stubs.o \
	build/vbcc-os3/frontends_amiga_z_autoinit.o \
	build/vbcc-os3/frontends_amiga_zlib_gzio.o

ROBJS = \
	build/vbcc-os3/frontends_amiga_regex_regcomp.o \
	build/vbcc-os3/frontends_amiga_regex_regexec.o \
	build/vbcc-os3/frontends_amiga_regex_regerror.o \
	build/vbcc-os3/frontends_amiga_regex_regfree.o

HOBJS = \
	build/vbcc-os3/frontends_amiga_hubbub_stubs.o \
	build/vbcc-os3/frontends_amiga_hubbub_nami_autoinit.o

DOBJS = \
	build/vbcc-os3/frontends_amiga_dom_stubs.o \
	build/vbcc-os3/frontends_amiga_dom_nami_autoinit.o

build/vbcc-os3/stamp:
	-MakeDir build
	-MakeDir build/vbcc-os3
	Echo ok >build/vbcc-os3/stamp

$(LIBDIR)/stamp: build/vbcc-os3/stamp
	-MakeDir $(LIBDIR)
	Echo ok >$(LIBDIR)/stamp

stage-libs: $(LIBDIR)/stamp
	Copy /libcss/css.lib $(LIBDIR)/css.lib
	Copy /libdom/dom.lib $(LIBDIR)/dom.lib
	Copy /libhubbub/hubbub.lib $(LIBDIR)/hubbub.lib
	Copy /libparserutils/parserutils.lib $(LIBDIR)/parserutils.lib
	Copy /libwapcaplet/wapcaplet.lib $(LIBDIR)/wapcaplet.lib
	Copy /libnsutils/nsutils.lib $(LIBDIR)/nsutils.lib

# Nami: no static hubbub.lib / dom.lib
stage-libs-nami: $(LIBDIR)/stamp
	Copy /libcss/css.lib $(LIBDIR)/css.lib
	Copy /libparserutils/parserutils.lib $(LIBDIR)/parserutils.lib
	Copy /libwapcaplet/wapcaplet.lib $(LIBDIR)/wapcaplet.lib
	Copy /libnsutils/nsutils.lib $(LIBDIR)/nsutils.lib

stage-nami-libs:
	-MakeDir $(NAMILIBDIR)
	Copy /libhubbub/hubbub.library $(NAMILIBDIR)/hubbub.library
	Copy /libdom/dom.library $(NAMILIBDIR)/dom.library

$(OBJS): build/vbcc-os3/stamp
$(ZOBJS): build/vbcc-os3/stamp
$(ROBJS): build/vbcc-os3/stamp
$(HOBJS): build/vbcc-os3/stamp
$(DOBJS): build/vbcc-os3/stamp

build/vbcc-os3/frontends_amiga_z_stubs.o: frontends/amiga/z_stubs.c
	vc $(VCFLAGS) -c -o build/vbcc-os3/frontends_amiga_z_stubs.o frontends/amiga/z_stubs.c

build/vbcc-os3/frontends_amiga_z_autoinit.o: frontends/amiga/z_autoinit.c
	vc $(VCFLAGS) -c -o build/vbcc-os3/frontends_amiga_z_autoinit.o frontends/amiga/z_autoinit.c

build/vbcc-os3/frontends_amiga_zlib_gzio.o: frontends/amiga/zlib_gzio.c
	vc $(VCFLAGS) -c -o build/vbcc-os3/frontends_amiga_zlib_gzio.o frontends/amiga/zlib_gzio.c

build/vbcc-os3/frontends_amiga_regex_regcomp.o: frontends/amiga/regex/regcomp.c
	vc $(VCFLAGS) -c -o build/vbcc-os3/frontends_amiga_regex_regcomp.o frontends/amiga/regex/regcomp.c

build/vbcc-os3/frontends_amiga_regex_regexec.o: frontends/amiga/regex/regexec.c
	vc $(VCFLAGS) -c -o build/vbcc-os3/frontends_amiga_regex_regexec.o frontends/amiga/regex/regexec.c

build/vbcc-os3/frontends_amiga_regex_regerror.o: frontends/amiga/regex/regerror.c
	vc $(VCFLAGS) -c -o build/vbcc-os3/frontends_amiga_regex_regerror.o frontends/amiga/regex/regerror.c

build/vbcc-os3/frontends_amiga_regex_regfree.o: frontends/amiga/regex/regfree.c
	vc $(VCFLAGS) -c -o build/vbcc-os3/frontends_amiga_regex_regfree.o frontends/amiga/regex/regfree.c

build/vbcc-os3/frontends_amiga_hubbub_stubs.o: frontends/amiga/hubbub_stubs.c
	vc $(VCFLAGS) -c -o build/vbcc-os3/frontends_amiga_hubbub_stubs.o frontends/amiga/hubbub_stubs.c

build/vbcc-os3/frontends_amiga_hubbub_nami_autoinit.o: frontends/amiga/hubbub_nami_autoinit.c
	vc $(VCFLAGS) -c -o build/vbcc-os3/frontends_amiga_hubbub_nami_autoinit.o frontends/amiga/hubbub_nami_autoinit.c

# Dom LVO stubs live in libdom (single source of truth with dom.library).
# -Ifrontends/amiga first so Nami's dom_stub_open.h wins over libdom's.
build/vbcc-os3/frontends_amiga_dom_stubs.o: /libdom/amiga/stubs/dom_stubs.c frontends/amiga/dom_stub_open.h
	vc $(VCFLAGS) -Ifrontends/amiga -I/libdom/amiga/stubs -c -o build/vbcc-os3/frontends_amiga_dom_stubs.o /libdom/amiga/stubs/dom_stubs.c

build/vbcc-os3/frontends_amiga_dom_nami_autoinit.o: frontends/amiga/dom_nami_autoinit.c frontends/amiga/dom_stub_open.h frontends/amiga/hubbub_stub_open.h
	vc $(VCFLAGS) -c -o build/vbcc-os3/frontends_amiga_dom_nami_autoinit.o frontends/amiga/dom_nami_autoinit.c

NetSurf: $(OBJS) $(ZOBJS) $(ROBJS) stage-libs
	vc +aos68k_posix -o NetSurf $(OBJS) $(ZOBJS) $(ROBJS) $(VLDFLAGS)

Nami: $(OBJS) $(ZOBJS) $(ROBJS) $(HOBJS) $(DOBJS) stage-libs-nami stage-nami-libs
	vc +aos68k_posix -o Nami $(OBJS) $(ZOBJS) $(ROBJS) $(HOBJS) $(DOBJS) $(NAMI_LDFLAGS)

Tsunami: $(TSUNAMI_OBJS) $(ZOBJS) $(ROBJS) stage-libs
	vc +aos68k_posix -o Tsunami $(TSUNAMI_OBJS) $(ZOBJS) $(ROBJS) $(VLDFLAGS)

clean:
	-Delete quiet force all build/vbcc-os3
	-Delete quiet NetSurf
	-Delete quiet Nami
	-Delete quiet Tsunami
	-Delete quiet $(NAMILIBDIR)/hubbub.library
	-Delete quiet $(NAMILIBDIR)/dom.library
